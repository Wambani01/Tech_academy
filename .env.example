# Supabase — Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary — images and lesson video
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# Server only — signs uploads from the media library
CLOUDINARY_API_SECRET=
# Optional: restricts signed uploads to one folder
CLOUDINARY_UPLOAD_FOLDER=marketing

# Transactional email (enquiry notifications)
RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAIL=admissions@techlabacademy.co

# Absolute origin, used for metadata and auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
